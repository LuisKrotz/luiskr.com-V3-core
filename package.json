{
  "name": "@luiskr/core",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./tokens/*": "./tokens/*.js",
    "./utils": "./utils/index.js",
    "./utils/*": "./utils/*.js",
    "./constants": "./constants.js",
    "./store": "./store.js",
    "./jsx": "./jsx.js",
    "./i18n": "./i18n.js",
    "./Component": "./Component.js",
    "./predictive-loader": "./predictive-loader.js"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "legacy-polyfills/*.ts",
    "safari/loader.ts",
    "safari/patch.ts",
    "firebase.ts",
    "store.ts",
    "predictive-loader.ts",
    "utils/motion/scroll-state.ts",
    "utils/gpu/gpu-accel.ts",
    "utils/media/local-media-cache.ts",
    "utils/gpu/npu-predict.ts",
    "utils/perf/stats-engine.ts",
    "utils/wasm/*.ts"
  ],
  "scripts": {
    "build": "vite build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --coverage"
  },
  "resolutions": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "dependencies": {
    "firebase": "^13.0.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.4"
  }
}
